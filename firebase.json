{
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Envejecer con Bienestar",
        "supportEmail": "casassantiago1@gmail.com",
        "authorizedRedirectUris": [
          "https://envejecerconbienestar-4ffb7.firebaseapp.com/__/auth/handler",
          "https://envejecerconbienestar.web.app/__/auth/handler",
          "https://envejecerconbienestar-4ffb7.web.app/__/auth/handler",
          "http://localhost"
        ]
      }
    }
  },
  "hosting": [
    {
      "site": "envejecerconbienestar",
      "public": "app/build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/@(index.html|flutter_bootstrap.js|main.dart.js|version.json|flutter_service_worker.js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/@(assets|canvaskit|icons)/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "envejecer-api",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "envejecerconbienestar-4ffb7",
